# Base URL of Providus's Document Intelligence Layer (DocAI).
# Optional — defaults to https://api.providus.ai (the hosted instance) when
# unset, so a Vercel deploy needs no configuration here. Only on-premises
# deployments need to override this, pointing it at their own instance.
DOCAI_BASE_URL=https://api.providus.ai

# No API key belongs here: this app is BYOK (bring-your-own-key) — each
# user pastes their own DocAI API key (from platform.providus.ai) in the
# app itself, and it's sealed into their session cookie, not read from env.

# API key for the DeepSeek LLM used during reconciliation.
DEEPSEEK_API_KEY=

# Secret used to encrypt session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: local OpenAI-compatible LLM server base URL (route lmstudio/<model>).
# Leave blank unless you are running LM Studio.
LM_STUDIO_URL=
